APP_NAME=Assessiva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Comma-separated IP addresses or CIDRs of trusted reverse proxies; leave blank if directly exposed.
TRUSTED_PROXIES=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL recommended) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ai_university
DB_USERNAME=postgres
DB_PASSWORD=

# For quick local trials without PostgreSQL (requires pdo_sqlite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Realtime (Reverb) — run: php artisan reverb:install ---
BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# --- Queues: use redis when Redis is available ---
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- AI microservice (FastAPI) — question bank generation uses this when URL is set ---
# Must match the port you pass to uvicorn (README uses 8088).
AI_SERVICE_URL=http://127.0.0.1:8088
AI_SERVICE_TIMEOUT=120
# PHP max_execution_time (seconds) during synchronous AI question generation; must exceed HTTP wait time.
AI_GENERATION_SYNC_MAX_EXECUTION=600
# auto: try FastAPI if AI_SERVICE_URL is set, then Laravel OpenAI/Gemini keys. No offline fallback.
# fastapi: require the Python service (fails loudly if unreachable).
AI_GENERATION_DRIVER=openai

# --- Exam script marking (theory / fill-in) ---
SCRIPT_MARKING_API_ENABLED=true
SCRIPT_MARKING_DRIVER=openai
# Base URL ( /mark-answer is appended automatically ). Falls back to AI_SERVICE_URL.
SCRIPT_MARKING_API_URL=
# SCRIPT_MARKING_LOG_PIPELINE=true
# Optional bearer token if your FastAPI deployment requires auth:
# SCRIPT_MARKING_API_KEY=

# Built-in Laravel drivers (only if SCRIPT_MARKING_DRIVER=openai or gemini):
# OPENAI_API_KEY=
# OPENAI_MARKING_MODEL=gpt-4o-mini
# GEMINI_API_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
